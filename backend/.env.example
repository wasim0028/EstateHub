# Backend .env.example
# Copy this file to .env and fill in your values

# Django Core
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL
DB_NAME=realestate_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# CORS — Next.js origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Media Storage — AWS S3 (set USE_S3=True to activate)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# Cloudinary (alternative — configure in settings.py)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments — Razorpay (UPI/PhonePe/GPay/cards). Get test keys from
# https://dashboard.razorpay.com/app/keys (toggle "Test Mode" on)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
SITE_VISIT_TOKEN_AMOUNT=500
