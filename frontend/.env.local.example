# Frontend .env.local.example
# Copy to .env.local

# Public — available in browser bundles (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Private — only available on the server side (no NEXT_PUBLIC_ prefix)
# Used in Route Handlers and Server Components to call Django directly
DJANGO_API_URL=http://localhost:8000

# Next.js
NEXTAUTH_URL=http://localhost:3000
